# Database (MySQL via XAMPP + phpMyAdmin).
# XAMPP default is user "root" with an empty password.
# Create the "veigin" database in phpMyAdmin (or just run `npm run db:up`,
# which creates it), then `npm run db:seed`.
DATABASE_URL="mysql://root@localhost:3306/veigin"

# App
NODE_ENV="development"

# Media (Cloudinary) - fill in before product uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (provider not chosen yet - Phase B)
EMAIL_HOST=""
EMAIL_PORT=""
EMAIL_USER=""
EMAIL_PASS=""

# Payments - manual Easypaisa display details (Phase B)
EASYPAISA_ACCOUNT_NUMBER=""
EASYPAISA_ACCOUNT_TITLE=""